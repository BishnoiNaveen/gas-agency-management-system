{
  "name": "gams-server",
  "version": "2.2.0",
  "description": "Bishnoi Gas Services API — MySQL (XAMPP) + bcrypt",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "presync": "node scripts/auto-sync-mysql.js",
    "sync": "node scripts/auto-sync-mysql.js",
    "seed": "node scripts/auto-sync-mysql.js --seed",
    "test": "node --test tests/",

    "migrate:force": "node scripts/migrate-to-mysql.js --force"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "better-sqlite3": "^11.7.0"
  }
}
